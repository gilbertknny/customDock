      { "label": "Timer 5m", "icon": "timer", "action": "timer", "minutes": 5 },
      { "label": "Lock", "icon": "lock", "path": "rundll32.exe", "args": [ "user32.dll,LockWorkStation" ] },
      { "label": "Settings", "icon": "gear", "uri": "ms-settings:" }
    ]

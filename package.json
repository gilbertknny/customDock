{
  "name": "frostshell",
  "version": "0.1.0",
  "description": "Glassmorphism dock + notch for Windows 11",
  "main": "src/main.js",
  "author": "FrostShell contributors",
  "license": "MIT",
  "keywords": [
    "windows-11",
    "dock",
    "notch",
    "notifications",
    "glassmorphism",
    "electron",
    "customization",
    "ricing"
  ],
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "dist": "electron-builder --win",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/config.js && node --check src/system/media.js && node --check src/system/processes.js && node --check src/system/stats.js && node --check src/system/wallpaper.js && node --check src/system/icons.js && node --check src/system/controls.js && node --check src/system/notifications.js && node --check src/system/shellwatch.js"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dev.frostshell.app",
    "productName": "FrostShell",
    "files": [
      "src/**/*",
      "assets/**/*",
      "config.default.json"
    ],
    "asarUnpack": [
      "src/system/*.ps1"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
